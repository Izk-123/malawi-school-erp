# Copy this file to .env and adjust as needed.
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite (default, no setup needed) or postgres
DB_ENGINE=sqlite
DB_NAME=malawi_school_erp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# memory (no Redis needed) or redis
CHANNEL_LAYER_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0

# True = Celery tasks run synchronously in-process, no worker/broker needed
CELERY_ALWAYS_EAGER=True

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@mzuzusec.mw

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# Payment gateways (FP-17/26). PayChangu is the default/only gateway
# wired up for now; leave PAYCHANGU_SECRET_KEY blank in dev and the
# "Pay Online" button will show a friendly "not configured yet" message
# instead of failing.
DEFAULT_PAYMENT_GATEWAY=paychangu
PAYCHANGU_ENABLED=True
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_TIMEOUT=15
